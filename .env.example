# Sentry credentials
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here   # Settings > Auth Tokens, needs project:read
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Datadog credentials
DD_API_KEY=your_datadog_api_key_here
DD_SITE=datadoghq.com   # or datadoghq.eu, us3.datadoghq.com, etc.

# Probe tuning (optional — these are the defaults)
PROBE_INTERVAL_SECONDS=60    # how often each probe runs
POLL_TIMEOUT_SECONDS=120     # give up polling Sentry after this long
POLL_INTERVAL_SECONDS=5      # how frequently to poll Sentry's API

# Alert firing probe
# 1. Expose this port publicly (or via ngrok: ngrok http 8080)
# 2. In Sentry: Settings > Integrations > Webhooks > Add URL: http://<your-host>:8080/webhook
# 3. Create an alert rule that fires on new issues and uses that webhook
ALERT_WEBHOOK_PORT=8080
ALERT_WEBHOOK_TIMEOUT_SECONDS=300
