# Sentry credentials
SENTRY_DSN=https://examplePublicKey@o0.ingest.us.sentry.io/0
SENTRY_AUTH_TOKEN=sntryu_your_auth_token_here   # User Auth Token — needs event:read + project:read + org:read
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# Datadog credentials
DD_API_KEY=your_datadog_api_key_here
DD_SITE=datadoghq.com   # or datadoghq.eu, us3.datadoghq.com, etc.

# Probe tuning (optional — these are the defaults). Every value here must stay
# consistent with the defaults in configFromEnv (main.go) and the Configuration
# table in README.md. PROBE_INTERVAL_SECONDS in particular: at 60 a batch's
# send+poll ceiling (the last scheduled send, just under PROBE_SEND_WINDOW_SECONDS,
# plus POLL_TIMEOUT_SECONDS + POLL_INTERVAL_SECONDS — 224s at these defaults)
# exceeds 2x the interval on every cycle, so the probe logs "skipping cycle"
# continuously as its steady state.
PROBE_INTERVAL_SECONDS=120    # how often each probe starts a batch
POLL_TIMEOUT_SECONDS=120      # give up polling Sentry after this long
POLL_INTERVAL_SECONDS=5       # how frequently to poll Sentry's API
PROBE_BATCH_SIZE=100          # synthetic events per type per cycle. 100 is also
                              # the MAXIMUM: each batch is looked up in one
                              # unpaginated Discover request and Sentry caps
                              # per_page at 100, so a bigger batch would be
                              # partly invisible and reported as dropped. The
                              # probe refuses to start above 100.
PROBE_SEND_WINDOW_SECONDS=100 # pace the batch across this window
SPAN_COMPLETENESS_SAMPLE=20   # arrived transactions sampled for span-count check
