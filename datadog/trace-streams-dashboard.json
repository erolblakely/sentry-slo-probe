              "y": 0,
              "width": 3,
              "height": 3
            }
          },
          {
            "definition": {
              "type": "timeseries",
              "title": "Traces with all 4 child spans stored (%)",
              "title_size": "16",
              "title_align": "left",
              "show_legend": true,
              "legend_layout": "horizontal",
              "legend_columns": [
                "avg",
                "max",
                "value"
              ],
              "requests": [
                {
                  "response_format": "timeseries",
                  "queries": [
                    {
                      "data_source": "metrics",
                      "name": "cmp_0",
                      "query": "sum:sentry.trace_stream.census.complete{$sentry_org,$sentry_project}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "chk_0",
                      "query": "sum:sentry.trace_stream.census.checked{$sentry_org,$sentry_project}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "cmp_1",
                      "query": "sum:sentry.trace_stream_otlp.census.complete{$sentry_org,$sentry_project}.as_count()"
                    },
                    {
                      "data_source": "metrics",
                      "name": "chk_1",
                      "query": "sum:sentry.trace_stream_otlp.census.checked{$sentry_org,$sentry_project}.as_count()"
                    }
                  ],
                  "formulas": [
                    {
                      "formula": "100 * cmp_0 / chk_0",
                      "alias": "SDK complete"
                    },
                    {
                      "formula": "100 * cmp_1 / chk_1",
                      "alias": "OTLP complete"
                    }
                  ],
                  "display_type": "line",
                  "style": {
                    "palette": "dog_classic",
                    "line_type": "solid",
                    "line_width": "normal"
                  }
                }
              ],
              "yaxis": {
                "include_zero": false,
